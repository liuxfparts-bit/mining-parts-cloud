# ============================================================
# 矿配云 环境变量配置
# 复制为 .env 并填入真实值
# ============================================================

# ---------- 数据库 ----------
# 本地开发（SQLite 零配置）：
DATABASE_URL="file:./dev.db"

# 生产环境（PostgreSQL / 腾讯云 TencentDB）：
# DATABASE_URL="postgresql://mining:强密码@localhost:5432/mining_parts_cloud?schema=public"

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 生产：https://www.your-domain.com

# ---------- 图片/文件存储 ----------
# 第一阶段本地存储：local
# 生产切换腾讯云 COS：cos
STORAGE_DRIVER="local"

# 腾讯云 COS 配置（STORAGE_DRIVER=cos 时启用）
COS_REGION="ap-beijing"
COS_BUCKET="mining-parts-cloud-1300000000"
COS_SECRET_ID="your-secret-id"
COS_SECRET_KEY="your-secret-key"
COS_CDN_DOMAIN="https://cdn.your-domain.com"

# ---------- 认证（后续接入 Auth.js） ----------
# AUTH_SECRET="生成一串随机字符串"
# AUTH_TRUST_HOST="true"
