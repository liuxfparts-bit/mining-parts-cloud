# ============================================================
# 矿配云 环境变量配置
# 复制为 .env 并填入真实值
# ============================================================

# ---------- 数据库 ----------
# 本地开发（SQLite 零配置）：
DATABASE_URL="file:./dev.db"

# 生产环境（PostgreSQL / 阿里云 RDS）：
# DATABASE_URL="postgresql://mining:强密码@localhost:5432/mining_parts_cloud?schema=public"

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 生产：https://www.your-domain.com

# ---------- 图片/文件存储 ----------
# 第一阶段本地存储：local
# 生产切换阿里云 OSS：oss
STORAGE_DRIVER="local"

# 阿里云 OSS 配置（STORAGE_DRIVER=oss 时启用）
OSS_REGION="oss-cn-hangzhou"
OSS_BUCKET="mining-parts-cloud"
OSS_ACCESS_KEY_ID="your-access-key-id"
OSS_ACCESS_KEY_SECRET="your-access-key-secret"
OSS_CDN_DOMAIN="https://cdn.your-domain.com"

# ---------- 认证（后续接入 Auth.js） ----------
# AUTH_SECRET="生成一串随机字符串"
# AUTH_TRUST_HOST="true"
