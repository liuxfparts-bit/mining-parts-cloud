# KuangPeiYun Staging Environment
# Copy to .env.staging and replace all CHANGE_ME values.
# Never commit .env.staging.

STAGING_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql://mining_staging:CHANGE_ME_STRONG_PASSWORD@postgres-staging:5432/mining_parts_staging

NEXT_PUBLIC_SITE_URL=http://localhost:3100
APP_URL=http://localhost:3100
AUTH_URL=http://localhost:3100
AUTH_SECRET=CHANGE_ME_STAGING_AUTH_SECRET

NODE_ENV=production
NEXT_PUBLIC_SITE_MODE=staging
STORAGE_DRIVER=local
